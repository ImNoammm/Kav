<?xml version="1.0" encoding="utf-8"?>
<!-- splash_icon.xml in Light's ink (#16161A) for the light launch screen: everything else is the same, so keep
     the two in step. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="432dp" android:height="432dp"
            android:viewportWidth="108" android:viewportHeight="108">
            <path
                android:name="lineLeft"
                android:strokeColor="#D916161A" android:strokeWidth="2.2" android:strokeLineCap="round"
                android:trimPathEnd="0"
                android:pathData="M44,67 C45.8,69.17 45.8,71.33 44,73.5 C42.2,75.67 42.2,77.83 44,80" />
            <path
                android:name="lineMiddle"
                android:strokeColor="#D916161A" android:strokeWidth="2.2" android:strokeLineCap="round"
                android:trimPathEnd="0"
                android:pathData="M54,64 C52.2,66.83 52.2,69.67 54,72.5 C55.8,75.33 55.8,78.17 54,81" />
            <path
                android:name="lineRight"
                android:strokeColor="#D916161A" android:strokeWidth="2.2" android:strokeLineCap="round"
                android:trimPathEnd="0"
                android:pathData="M64,67 C65.8,69.17 65.8,71.33 64,73.5 C62.2,75.67 62.2,77.83 64,80" />
            <group android:name="arrow" android:pivotX="54" android:pivotY="54">
                <group android:name="shake" android:pivotX="54" android:pivotY="60">
                    <path
                        android:name="arrowPath"
                        android:fillColor="#FF16161A"
                        android:fillAlpha="0"
                        android:pathData="M52.47,33.55 A1.73,1.73 0 0,1 55.53,33.55 L76.76,74.34 A0.95,0.95 0 0,1 75.59,75.67 L54,67.68 L32.41,75.67 A0.95,0.95 0 0,1 31.24,74.34 Z" />
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="arrowPath">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1"
                android:duration="120" android:interpolator="@android:interpolator/linear" />
        </aapt:attr>
    </target>
    <target android:name="arrow">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.8" android:valueTo="1"
                    android:duration="260" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.8" android:valueTo="1"
                    android:duration="260" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="translateY" android:valueFrom="0" android:valueTo="-7"
                    android:startOffset="100" android:duration="300" android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
    <!-- The restless tremble before take-off: small, quick, and back at rest when it ends. -->
    <target android:name="shake">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="translateX" android:startOffset="200" android:duration="400"
                    android:interpolator="@android:interpolator/linear">
                    <propertyValuesHolder android:propertyName="translateX">
                        <keyframe android:fraction="0" android:value="0" />
                        <keyframe android:fraction="0.12" android:value="-0.7" />
                        <keyframe android:fraction="0.25" android:value="0.6" />
                        <keyframe android:fraction="0.38" android:value="-0.6" />
                        <keyframe android:fraction="0.5" android:value="0.5" />
                        <keyframe android:fraction="0.62" android:value="-0.5" />
                        <keyframe android:fraction="0.75" android:value="0.4" />
                        <keyframe android:fraction="0.88" android:value="-0.3" />
                        <keyframe android:fraction="1" android:value="0" />
                    </propertyValuesHolder>
                </objectAnimator>
                <objectAnimator android:propertyName="rotation" android:startOffset="200" android:duration="400"
                    android:interpolator="@android:interpolator/linear">
                    <propertyValuesHolder android:propertyName="rotation">
                        <keyframe android:fraction="0" android:value="0" />
                        <keyframe android:fraction="0.17" android:value="1.6" />
                        <keyframe android:fraction="0.33" android:value="-1.4" />
                        <keyframe android:fraction="0.5" android:value="1.2" />
                        <keyframe android:fraction="0.67" android:value="-1" />
                        <keyframe android:fraction="0.83" android:value="0.6" />
                        <keyframe android:fraction="1" android:value="0" />
                    </propertyValuesHolder>
                </objectAnimator>
            </set>
        </aapt:attr>
    </target>
    <!-- Each line grows down from under the arrow and wiggles between two wave shapes, ending on the first. -->
    <target android:name="lineMiddle">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1"
                    android:startOffset="150" android:duration="270" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="pathData" android:valueType="pathType"
                    android:valueFrom="M54,64 C52.2,66.83 52.2,69.67 54,72.5 C55.8,75.33 55.8,78.17 54,81"
                    android:valueTo="M54,64 C55.8,66.83 55.8,69.67 54,72.5 C52.2,75.33 52.2,78.17 54,81"
                    android:startOffset="150" android:duration="75" android:repeatCount="5" android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="lineLeft">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1"
                    android:startOffset="190" android:duration="260" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="pathData" android:valueType="pathType"
                    android:valueFrom="M44,67 C45.8,69.17 45.8,71.33 44,73.5 C42.2,75.67 42.2,77.83 44,80"
                    android:valueTo="M44,67 C42.2,69.17 42.2,71.33 44,73.5 C45.8,75.67 45.8,77.83 44,80"
                    android:startOffset="150" android:duration="75" android:repeatCount="5" android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="lineRight">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1"
                    android:startOffset="190" android:duration="260" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="pathData" android:valueType="pathType"
                    android:valueFrom="M64,67 C65.8,69.17 65.8,71.33 64,73.5 C62.2,75.67 62.2,77.83 64,80"
                    android:valueTo="M64,67 C62.2,69.17 62.2,71.33 64,73.5 C65.8,75.67 65.8,77.83 64,80"
                    android:startOffset="150" android:duration="75" android:repeatCount="5" android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
