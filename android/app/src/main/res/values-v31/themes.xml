<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and newer draw a launch screen of their own: this gives it Kav's animated logo, in the look of
         launch.xml while Kav follows the phone. -->
    <style name="Theme.Kav" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/kav_launch_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/kav_launch_light</item>
        <item name="android:windowSplashScreenBackground">@color/kav_launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_auto</item>
        <item name="android:windowSplashScreenAnimationDuration">600</item>
    </style>

    <!-- A look the rider picked, for the next launch screen (LaunchLook, Android 13 and newer). -->
    <style name="Theme.Kav.Launch.Light" parent="Theme.Kav">
        <item name="android:windowSplashScreenBackground">#F2F2EF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Kav.Launch.Dark" parent="Theme.Kav">
        <item name="android:windowSplashScreenBackground">#101012</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.Kav.Launch.Oled" parent="Theme.Kav">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
