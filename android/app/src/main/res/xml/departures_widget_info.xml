<?xml version="1.0" encoding="utf-8"?>
<!-- The next buses at a saved stop, the rider's choice as it's placed (DeparturesWidget.kt). Resizable both ways; Android
     asks for an update every half hour at most, the least it allows, and Kav refreshes it besides when the saved stops
     change. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="uk.noammm.kav.DeparturesWidgetConfigActivity"
    android:description="@string/widget_departures_description"
    android:initialLayout="@layout/widget_departures"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="50dp"
    android:previewLayout="@layout/widget_departures"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
