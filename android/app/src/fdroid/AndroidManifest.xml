<?xml version="1.0" encoding="utf-8"?>
<!-- The F-Droid build (-PkavFdroid), over the main manifest: F-Droid updates Kav, so Kav's own updater and what only it
     needs are taken out. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" tools:node="remove" />

    <application>
        <receiver android:name=".InstallStatus" tools:node="remove" />
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.updates" tools:node="remove" />
    </application>
</manifest>
